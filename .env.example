# ============================================================
# Environment configuration — copy this file to `.env` and edit.
#   cp .env.example .env
# `.env` is git-ignored. NEVER commit real secrets.
# ============================================================

# --- Application ---

# Environment name: development | test | production
APP_ENV=development

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Database ---
# Credentials for the PostgreSQL container started by docker-compose.
# These defaults are for LOCAL DEVELOPMENT ONLY — change the password
# if this database is ever reachable from outside your machine.
POSTGRES_USER=ecom
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=ecom

# Full connection URL the application uses.
# Inside docker compose the host is `db`; when running the app directly
# on your machine (e.g. tests), use `localhost` instead.
DATABASE_URL=postgresql+psycopg://ecom:change-me-local-only@localhost:5432/ecom

# --- Providers ---

# Keepa API key (licensed Amazon price/rank/review history). Required only to run
# the Keepa collection job (`atlas collect-keepa`). The app boots without it; the
# command fails with exit code 2 if it is missing. NEVER commit a real key.
KEEPA_API_KEY=

# Default interval (seconds) between autonomous collection cycles when running
# `atlas schedule`. Overridable per run with --interval-seconds. Default 86400 (1 day).
KEEPA_COLLECTION_INTERVAL_SECONDS=86400

# REQUIRED FOR TESTS: a separate, dedicated test database. The test suite
# runs destructive migrations against it and will REFUSE to run unless this
# is set AND the database name contains "test" (e.g. ends with `_test`).
# Tests never touch DATABASE_URL. Docker compose creates `ecom_test`
# automatically on a fresh database volume.
TEST_DATABASE_URL=postgresql+psycopg://ecom:change-me-local-only@localhost:5432/ecom_test
